# ==============================================================================
# GridWise AI — Environment Configuration & API Keys
# ==============================================================================
# NOTE: GridWise AI is completely self-contained and operates 100% locally
# without requiring any mandatory paid API keys! The Reinforcement Learning (RL)
# engine, Digital Twin, and database run offline.
#
# To configure optional services, copy this file to .env:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL: LLM Advisory Insights
# ------------------------------------------------------------------------------
# Optional: Used by OpenAIService to generate natural language executive insights
# If left blank, GridWise AI automatically falls back to its internal expert system.
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. APPLICATION & SECURITY KEYS
# ------------------------------------------------------------------------------
# Secret key used for session hashing and platform authentication.
# Change this in production environments.
SECRET_KEY=gridwise-secret-key-2026

# Environment name: development | production | testing
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 3. DATABASE & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Default SQLite database path. Can be changed to postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./gridwise.db

# Host and Port for the FastAPI server
HOST=127.0.0.1
PORT=8000
